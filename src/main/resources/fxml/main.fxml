<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<VBox fx:id="rootContainer" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.tobacco.weight.ui.MainController"
      spacing="1" styleClass="main-container" minHeight="800" fillWidth="true">
    


    <!-- 主要内容区域 - 固定高度避免覆盖 -->
    <HBox fx:id="mainContentArea" spacing="8" VBox.vgrow="ALWAYS" styleClass="main-content-area" minHeight="360" alignment="TOP_CENTER">
        <padding>
            <Insets top="0" right="8" bottom="0" left="8"/>
        </padding>
        
        <!-- 左侧：主要操作区域（改为网格布局以充分利用空间） -->
        <GridPane fx:id="mainGrid" hgap="4" vgap="8" HBox.hgrow="ALWAYS">
            <columnConstraints>
                <!-- 顶部行 50/50；第二行 25/20/55。由于一个 GridPane 共享列，我们综合设置为近似权重，具体通过子 GridPane 控制。-->
                <ColumnConstraints percentWidth="25" hgrow="ALWAYS" minWidth="260"/>
                <ColumnConstraints percentWidth="20" hgrow="ALWAYS" minWidth="220"/>
                <ColumnConstraints percentWidth="55" hgrow="ALWAYS" minWidth="320"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints vgrow="ALWAYS"/>
                <RowConstraints vgrow="ALWAYS"/>
            </rowConstraints>

            <!-- 顶部行：使用内部GridPane实现50/50平分，并与第二行边距一致 -->
            <GridPane hgap="4" vgap="0" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="3">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                </columnConstraints>
                <!-- 左：烟农信息 -->
                <VBox styleClass="input-panel" spacing="1" alignment="CENTER" GridPane.columnIndex="0" GridPane.hgrow="ALWAYS">
                    <Label text="烟农信息" styleClass="section-title"/>
                    <VBox spacing="1" alignment="CENTER">
                        <HBox spacing="5" alignment="CENTER">
                            <VBox spacing="1">
                                <Label text="烟农姓名:" styleClass="field-label"/>
                                <TextField fx:id="farmerNameField" promptText="请输入烟农姓名" styleClass="farmer-input-field"/>
                            </VBox>
                            <VBox spacing="1">
                                <Label text="合同号:" styleClass="field-label"/>
                                <TextField fx:id="contractNumberField" promptText="合同号" styleClass="farmer-input-field"/>
                            </VBox>
                        </HBox>
                        <HBox spacing="8" alignment="CENTER">
                            <VBox spacing="1">
                                <Label text="身份证号:" styleClass="field-label"/>
                                <TextField fx:id="idCardNumberField" promptText="请输入身份证号" styleClass="farmer-input-field"/>
                            </VBox>
                            <VBox spacing="1">
                                <Label text="捆数:" styleClass="field-label"/>
                                <TextField fx:id="bundleCountField" promptText="请输入捆数" styleClass="farmer-input-field"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </VBox>
                <!-- 右：当前重量显示 -->
                <VBox alignment="CENTER" styleClass="weight-display-large" spacing="1" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS">
                    <Label fx:id="operationTipLabel" text="请选择叶位类型" styleClass="operation-tip-label"/>
                    <Label text="当前重量" styleClass="section-title"/>
                    <Label fx:id="currentWeightLabel" text="0.00 kg" styleClass="weight-value"/>
                </VBox>
            </GridPane>
            <!-- 顶部不再放预检信息，已移动到称重操作左侧 -->

            <!-- 左下：数字软键盘（居中对齐） -->
            <VBox fx:id="numberKeypadContainer" spacing="1" styleClass="number-keypad-large" alignment="CENTER"
                  prefWidth="280" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.vgrow="NEVER" GridPane.halignment="CENTER">
                <GridPane hgap="2" vgap="2" alignment="CENTER">
                    <Button fx:id="key1" text="1" styleClass="keypad-button-large" prefWidth="95" prefHeight="70" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <Button fx:id="key2" text="2" styleClass="keypad-button-large" prefWidth="95" prefHeight="70" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Button fx:id="key3" text="3" styleClass="keypad-button-large" prefWidth="95" prefHeight="70" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <Button fx:id="key4" text="4" styleClass="keypad-button-large" prefWidth="95" prefHeight="70" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <Button fx:id="key5" text="5" styleClass="keypad-button-large" prefWidth="95" prefHeight="70" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <Button fx:id="key6" text="6" styleClass="keypad-button-large" prefWidth="95" prefHeight="70" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <Button fx:id="key7" text="7" styleClass="keypad-button-large" prefWidth="95" prefHeight="70" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <Button fx:id="key8" text="8" styleClass="keypad-button-large" prefWidth="95" prefHeight="70" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <Button fx:id="key9" text="9" styleClass="keypad-button-large" prefWidth="95" prefHeight="70" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                    <Button fx:id="keyClear" text="C" styleClass="keypad-clear-button-large" prefWidth="95" prefHeight="70" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <Button fx:id="key0" text="0" styleClass="keypad-button-large" prefWidth="95" prefHeight="70" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                    <Button fx:id="keyBack" text="⌫" styleClass="keypad-back-button-large" prefWidth="95" prefHeight="70" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                </GridPane>
            </VBox>

            <!-- 中下：预检信息（位于软键盘与操作区之间） -->
            <VBox styleClass="ratio-panel" spacing="8" alignment="TOP_CENTER" GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.hgrow="ALWAYS">
                <Label text="预检信息" styleClass="section-title ratio-title"/>
                <VBox spacing="6" alignment="TOP_CENTER">
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <Label text="预检比例:" styleClass="field-label ratio-label-large"/>
                        <TextField fx:id="precheckRatioField" promptText="0.0%" styleClass="ratio-input-field" editable="false"/>
                    </HBox>
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <Label text="上部叶:" styleClass="field-label ratio-label-large"/>
                        <TextField fx:id="upperRatioField" promptText="0.0%" styleClass="ratio-input-field" editable="false"/>
                    </HBox>
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <Label text="中部叶:" styleClass="field-label ratio-label-large"/>
                        <TextField fx:id="middleRatioField" promptText="0.0%" styleClass="ratio-input-field" editable="false"/>
                    </HBox>
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <Label text="下部叶:" styleClass="field-label ratio-label-large"/>
                        <TextField fx:id="lowerRatioField" promptText="0.0%" styleClass="ratio-input-field" editable="false"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- 右下：操作控制区域（右列） -->
            <VBox styleClass="control-panel" spacing="8" alignment="TOP_CENTER" GridPane.columnIndex="2" GridPane.rowIndex="1" GridPane.hgrow="ALWAYS">
                <Label text="称重操作" styleClass="section-title"/>
                <VBox spacing="6" alignment="CENTER">
                    <Label text="请选择部叶类型:" styleClass="field-label"/>
                    <HBox spacing="8" alignment="CENTER">
                        <Button fx:id="upperLeafButton" text="上部叶" styleClass="leaf-button"/>
                        <Button fx:id="middleLeafButton" text="中部叶" styleClass="leaf-button"/>
                        <Button fx:id="lowerLeafButton" text="下部叶" styleClass="leaf-button"/>
                    </HBox>
                </VBox>
                <HBox spacing="12" alignment="CENTER">
                    <Button fx:id="confirmButton" text="确认称重" styleClass="confirm-button"/>
                    <Button fx:id="readIdCardButton" styleClass="id-card-button">
                        <graphic>
                            <HBox spacing="5" alignment="CENTER">
                                <Label fx:id="idCardStatusIcon" text="●" styleClass="status-icon"/>
                                <Label text="读取身份证"/>
                            </HBox>
                        </graphic>
                    </Button>
                </HBox>
                <HBox spacing="20" alignment="CENTER" styleClass="precheck-info-panel" GridPane.hgrow="ALWAYS">
                    <HBox spacing="6" alignment="CENTER">
                        <Label text="用户编号:" styleClass="field-label"/>
                        <Label fx:id="precheckIdLabel" text="YJ100000000" styleClass="info-value"/>
                    </HBox>
                    <HBox spacing="6" alignment="CENTER">
                        <Label text="日期:" styleClass="field-label"/>
                        <Label fx:id="precheckDateLabel" text="2024-01-01" styleClass="info-value"/>
                    </HBox>
                </HBox>
            </VBox>
        </GridPane>
        
        <!-- 右侧区域已并入右上方 HBox，无需单独面板 -->
    </HBox>
    
    <!-- 分隔区域 - 固定小间距，避免出现大块空白 -->
    <Region VBox.vgrow="NEVER" prefHeight="8" minHeight="6" maxHeight="12"/>
    
    <!-- 管理员登录区域 - 平衡高度避免覆盖 -->
    <VBox styleClass="admin-panel" spacing="8" VBox.vgrow="NEVER" alignment="CENTER" prefHeight="200" minHeight="180" maxHeight="240">
        <VBox spacing="6" alignment="CENTER">
            <Label text="管理员功能" styleClass="admin-title-label"/>
            <Label text="请登录管理员账户以访问管理功能" styleClass="admin-subtitle-label"/>
        </VBox>
        
        <HBox spacing="18" alignment="CENTER">
            <Button fx:id="adminLoginButton" text="管理员登录" styleClass="admin-login-button"/>
            <Button fx:id="farmerRegistrationButton" text="农户注册管理" styleClass="export-button"/>
        </HBox>
        
        <!-- 登录状态显示 -->
        <VBox fx:id="adminStatusContainer" spacing="5" alignment="CENTER" visible="false">
            <Label fx:id="adminStatusLabel" text="" styleClass="admin-status-label"/>
            <HBox spacing="10" alignment="CENTER">
                <Button fx:id="openAdminPanelButton" text="打开管理面板" styleClass="export-button" visible="false"/>
                <Button fx:id="exportAllDataButton" text="导出所有数据" styleClass="export-button" visible="false"/>
                <Button fx:id="adminLogoutButton" text="登出" styleClass="logout-button" visible="false"/>
            </HBox>
        </VBox>
    </VBox>
    
    <!-- 状态栏 - 占总高度的9%，为按钮预留充足空间 -->
    <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="10" VBox.vgrow="NEVER" prefHeight="48" minHeight="44" maxHeight="52">
        <Label fx:id="statusLabel" text="系统就绪" styleClass="status-label"/>
        <ProgressBar fx:id="progressBar" visible="false" prefWidth="200"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="diagnosticsButton" text="硬件诊断" styleClass="export-button"/>
    </HBox>
    
</VBox> 