<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<VBox fx:id="rootContainer" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.tobacco.weight.ui.MainController"
      spacing="1" styleClass="main-container" minHeight="800" fillWidth="true">
    


    <!-- 主要内容区域 - 固定高度避免覆盖 -->
    <HBox fx:id="mainContentArea" spacing="10" VBox.vgrow="NEVER" styleClass="main-content-area" prefHeight="400" minHeight="400" maxHeight="400">
        
        <!-- 左侧：主要操作区域 -->
        <VBox spacing="1" HBox.hgrow="NEVER" prefWidth="950">
            
            <!-- 上部：输入和重量显示区域 -->
            <HBox spacing="1">
                <!-- 左侧：烟农信息输入 -->
                <VBox styleClass="input-panel" spacing="1" prefWidth="350">
                <Label text="烟农信息" styleClass="section-title"/>
                
                <!-- 烟农信息 - 紧凑布局 -->
                <VBox spacing="1">
                    <!-- 第一行：烟农姓名和合同号 -->
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <VBox spacing="1">
                            <Label text="烟农姓名:" styleClass="field-label"/>
                            <TextField fx:id="farmerNameField" promptText="请输入烟农姓名" prefWidth="170"/>
                        </VBox>
                        <VBox spacing="1">
                            <Label text="合同号:" styleClass="field-label"/>
                            <TextField fx:id="contractNumberField" promptText="合同号" prefWidth="170"/>
                        </VBox>
                    </HBox>
                    
                    <!-- 第二行：身份证号和捆数 -->
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <VBox spacing="1">
                            <Label text="身份证号:" styleClass="field-label"/>
                            <TextField fx:id="idCardNumberField" promptText="请输入身份证号" prefWidth="200"/>
                        </VBox>
                        <VBox spacing="1">
                            <Label text="捆数:" styleClass="field-label"/>
                            <TextField fx:id="bundleCountField" promptText="请输入捆数" prefWidth="100"/>
                        </VBox>
                    </HBox>
                </VBox>
            </VBox>
            
                <!-- 右侧：重量显示 -->
                <VBox alignment="CENTER" styleClass="weight-display-large" spacing="1" prefWidth="240" maxWidth="240">
                    <!-- 操作提示信息 -->
                    <Label fx:id="operationTipLabel" text="请选择叶位类型" styleClass="operation-tip-label"/>
                    <Label text="当前重量" styleClass="section-title"/>
                    <Label fx:id="currentWeightLabel" text="0.00 kg" styleClass="weight-value"/>
                </VBox>
        </HBox>
        
            <!-- 中部：软键盘和操作区域 -->
            <HBox spacing="1" VBox.vgrow="NEVER">
                <!-- 左侧：数字软键盘 -->
                <VBox fx:id="numberKeypadContainer" spacing="1" styleClass="number-keypad-large" alignment="CENTER" prefWidth="280">
                <GridPane hgap="2" vgap="2" alignment="CENTER">
                    <Button fx:id="key1" text="1" styleClass="keypad-button-large" prefWidth="95" prefHeight="70" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <Button fx:id="key2" text="2" styleClass="keypad-button-large" prefWidth="95" prefHeight="70" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Button fx:id="key3" text="3" styleClass="keypad-button-large" prefWidth="95" prefHeight="70" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    
                    <Button fx:id="key4" text="4" styleClass="keypad-button-large" prefWidth="95" prefHeight="70" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <Button fx:id="key5" text="5" styleClass="keypad-button-large" prefWidth="95" prefHeight="70" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <Button fx:id="key6" text="6" styleClass="keypad-button-large" prefWidth="95" prefHeight="70" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    
                    <Button fx:id="key7" text="7" styleClass="keypad-button-large" prefWidth="95" prefHeight="70" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <Button fx:id="key8" text="8" styleClass="keypad-button-large" prefWidth="95" prefHeight="70" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <Button fx:id="key9" text="9" styleClass="keypad-button-large" prefWidth="95" prefHeight="70" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                    
                    <Button fx:id="keyClear" text="C" styleClass="keypad-clear-button-large" prefWidth="95" prefHeight="70" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <Button fx:id="key0" text="0" styleClass="keypad-button-large" prefWidth="95" prefHeight="70" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                    <Button fx:id="keyBack" text="⌫" styleClass="keypad-back-button-large" prefWidth="95" prefHeight="70" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                </GridPane>
            </VBox>
            
                <!-- 右侧：操作控制区域 -->
                <VBox styleClass="control-panel" spacing="1" alignment="CENTER" HBox.hgrow="ALWAYS">
                <Label text="称重操作" styleClass="section-title"/>
                
                <!-- 部叶选择按钮 -->
                <VBox spacing="1" alignment="CENTER">
                    <Label text="请选择部叶类型:" styleClass="field-label"/>
                                            <HBox spacing="2" alignment="CENTER">
                        <Button fx:id="upperLeafButton" text="上部叶" styleClass="leaf-button" prefWidth="140"/>
                        <Button fx:id="middleLeafButton" text="中部叶" styleClass="leaf-button" prefWidth="140"/>
                        <Button fx:id="lowerLeafButton" text="下部叶" styleClass="leaf-button" prefWidth="140"/>
                    </HBox>
                </VBox>
                
                    <!-- 操作按钮 -->
                    <VBox spacing="3" alignment="CENTER">
                    <Button fx:id="confirmButton" text="确认称重" styleClass="confirm-button" prefWidth="200"/>
                    <Button fx:id="readIdCardButton" styleClass="id-card-button" prefWidth="200">
                        <graphic>
                            <HBox spacing="5" alignment="CENTER">
                                <Label fx:id="idCardStatusIcon" text="●" styleClass="status-icon"/>
                                <Label text="读取身份证"/>
                            </HBox>
                        </graphic>
                    </Button>
                </VBox>
                
                    <!-- 用户编号和日期 -->
                    <VBox spacing="1" alignment="CENTER" styleClass="precheck-info-panel">
                                        <HBox spacing="3" alignment="CENTER">
                            <Label text="用户编号:" styleClass="field-label"/>
                            <Label fx:id="precheckIdLabel" text="YJ100000000" styleClass="info-value"/>
                        </HBox>
                        <HBox spacing="3" alignment="CENTER">
                            <Label text="日期:" styleClass="field-label"/>
                            <Label fx:id="precheckDateLabel" text="2024-01-01" styleClass="info-value"/>
                        </HBox>
                </VBox>
            </VBox>
        </HBox>
        </VBox>
        
        <!-- 右侧：预检信息区域 -->
        <VBox styleClass="ratio-panel" spacing="0" alignment="TOP_LEFT" prefWidth="220" HBox.hgrow="NEVER">
            <Label text="预检信息" styleClass="section-title"/>
            
            <!-- 预检比例显示 - 超紧凑水平布局 -->
            <VBox spacing="2" alignment="TOP_LEFT">
                <!-- 预检比例 -->
                <HBox spacing="3" alignment="CENTER_LEFT">
                    <Label text="预检比例:" styleClass="field-label" prefWidth="65"/>
                    <TextField fx:id="precheckRatioField" promptText="0.0%" styleClass="ratio-value" editable="false" prefWidth="140"/>
                </HBox>
                
                <!-- 上部叶比例 -->
                <HBox spacing="3" alignment="CENTER_LEFT">
                    <Label text="上部叶:" styleClass="field-label" prefWidth="65"/>
                    <TextField fx:id="upperRatioField" promptText="0.0%" styleClass="ratio-value" editable="false" prefWidth="140"/>
                </HBox>
                
                <!-- 中部叶比例 -->
                <HBox spacing="3" alignment="CENTER_LEFT">
                    <Label text="中部叶:" styleClass="field-label" prefWidth="65"/>
                    <TextField fx:id="middleRatioField" promptText="0.0%" styleClass="ratio-value" editable="false" prefWidth="140"/>
                </HBox>
                
                <!-- 下部叶比例 -->
                <HBox spacing="3" alignment="CENTER_LEFT">
                    <Label text="下部叶:" styleClass="field-label" prefWidth="65"/>
                    <TextField fx:id="lowerRatioField" promptText="0.0%" styleClass="ratio-value" editable="false" prefWidth="140"/>
                </HBox>
            </VBox>
        </VBox>
        
        <!-- 右侧弹性空间，帮助布局居中 -->
        <Region HBox.hgrow="ALWAYS" minWidth="20"/>
    </HBox>
    
    <!-- 分隔区域 - 最小化间距 -->
    <Region VBox.vgrow="ALWAYS" minHeight="10"/>
    
    <!-- 管理员登录区域 - 平衡高度避免覆盖 -->
    <VBox styleClass="admin-panel" spacing="12" VBox.vgrow="NEVER" alignment="CENTER" prefHeight="240" minHeight="240" maxHeight="260">
        <VBox spacing="6" alignment="CENTER">
            <Label text="管理员功能" styleClass="admin-title-label"/>
            <Label text="请登录管理员账户以访问管理功能" styleClass="admin-subtitle-label"/>
        </VBox>
        
        <HBox spacing="18" alignment="CENTER">
            <Button fx:id="adminLoginButton" text="管理员登录" styleClass="admin-login-button"/>
            <Button fx:id="farmerRegistrationButton" text="农户注册管理" styleClass="export-button"/>
        </HBox>
        
        <!-- 登录状态显示 -->
        <VBox fx:id="adminStatusContainer" spacing="5" alignment="CENTER" visible="false">
            <Label fx:id="adminStatusLabel" text="" styleClass="admin-status-label"/>
            <HBox spacing="10" alignment="CENTER">
                <Button fx:id="openAdminPanelButton" text="打开管理面板" styleClass="export-button" visible="false"/>
                <Button fx:id="exportAllDataButton" text="导出所有数据" styleClass="export-button" visible="false"/>
                <Button fx:id="adminLogoutButton" text="登出" styleClass="logout-button" visible="false"/>
            </HBox>
        </VBox>
    </VBox>
    
    <!-- 状态栏 - 占总高度的9%，为按钮预留充足空间 -->
    <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="10" VBox.vgrow="NEVER" prefHeight="70" minHeight="70" maxHeight="70">
        <Label fx:id="statusLabel" text="系统就绪" styleClass="status-label"/>
        <ProgressBar fx:id="progressBar" visible="false" prefWidth="200"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="diagnosticsButton" text="硬件诊断" styleClass="export-button"/>
    </HBox>
    
</VBox> 